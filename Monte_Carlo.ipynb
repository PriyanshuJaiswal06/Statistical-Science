    "import yaml\n",
    "import pandas as pd\n",
    "import os\n",
    "\n",
    "file_path = os.path.join(\"ipl\", \"335982.yaml\")\n",
    "\n",
    "with open(file_path, 'r') as file:\n",
    "    yaml_data = yaml.safe_load(file)\n",
    "\n",
    "df = pd.DataFrame([yaml_data.get(\"info\", {})])\n",
    "df.to_excel(\"players.xlsx\", index=False)"
   ]
  }
